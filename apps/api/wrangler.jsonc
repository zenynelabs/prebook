{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prebook-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://www.prebookingpbkworld.com,https://prebookingpbkworld.com,http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prebook-events",
      "database_id": "dd11bb22-5e87-406b-b81d-a22348c87ab1"
    }
  ],
  // Product, logo and banner photos, served back through GET /images/shops/...
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "prebook-shop-images" }],
  // ponytail: per-IP limits (form 10/min, admin 120/min), add Turnstile if bots get past them.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ]
  // ADMIN_TOKEN is a secret: `wrangler secret put ADMIN_TOKEN`, and `.dev.vars` locally.
}
